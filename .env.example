# Generate a unique value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# External web port. Set to 8080 if port 80 is already in use.
WEB_PORT=80

# Use same-origin API requests through Nginx (or set an external API URL).
VITE_API_URL=__SAME_ORIGIN__

CORS_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_URL=http://localhost
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aevona Solutions
SMTP_USE_SSL=false
